{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "ar",
  "permissions": ["storage"],
  "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.twitter.com/*", "*://*.x.com/*"],
      "css": ["content/content.css"],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "oneclickblock@yourdomain.com",
      "strict_min_version": "109.0"
    }
  }
}
